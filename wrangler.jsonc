{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "rger-dev",
    "compatibility_date": "2025-12-30",
    "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
    "assets": {
        "directory": "./dist"
    },
    "observability": {
        "enabled": true
    }
}
