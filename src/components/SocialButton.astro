---
import { Icon } from 'astro-icon/components'

interface Props {
    platform: string
    url: string
}

const { platform, url } = Astro.props
const isX = platform.toLowerCase() === 'twitter'
---

<a href={url} aria-label={`Link to my ${platform}`}>
    {
        isX ? (
            <svg
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
                class="w-10 h-10 text-zinc-200 hover:text-zinc-400"
            >
                <path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z" />
            </svg>
        ) : (
            <Icon
                name={`mdi:${platform.toLowerCase()}`}
                class="w-10 h-10 text-zinc-200 hover:text-zinc-400"
            />
        )
    }
</a>
